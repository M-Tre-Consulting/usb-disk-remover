import { Button, CheckBox, Spinner, ScrollView, Palette } from "std-widgets.slint";

export struct DriveItem {
    mount_point: string,
    label: string,
    vendor: string,
    product: string,
    bus_type: string,
}

export struct I18nStrings {
    settings_btn: string,
    about_btn: string,
    refresh_btn: string,
    scanning: string,
    no_drives_title: string,
    no_drives_desc: string,
    scan_for_drives: string,
    unlabeled_volume: string,
    storage_device: string,
    safely_remove: string,
    removing: string,
    ready: string,
    settings_title: string,
    settings_desc: string,
    language_label: string,
    autostart_title: string,
    autostart_desc: string,
    start_minimized_title: string,
    start_minimized_desc: string,
    close_to_tray_title: string,
    close_to_tray_desc: string,
    save_btn: string,
    close_btn: string,
    about_desc: string,
    about_ref: string,
    tray_open: string,
    tray_settings: string,
    tray_about: string,
    tray_quit: string,
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../icons/32x32.png");
    tooltip: "USB Disk Remover";

    in property <string> title_open: "Open USB Disk Remover";
    in property <string> title_settings: "Settings...";
    in property <string> title_about: "About...";
    in property <string> title_quit: "Quit";

    callback toggle_window();
    callback show_settings();
    callback show_about();
    callback quit();

    clicked => { toggle_window(); }

    Menu {
        MenuItem {
            title: root.title_open;
            activated => { toggle_window(); }
        }
        MenuItem {
            title: root.title_settings;
            activated => { show_settings(); }
        }
        MenuItem {
            title: root.title_about;
            activated => { show_about(); }
        }
        MenuItem {
            title: root.title_quit;
            activated => { quit(); }
        }
    }
}

component SettingCard inherits Rectangle {
    in property <bool> is_dark: false;
    in property <bool> is_win11: true;
    in property <string> title;
    in property <string> description;
    in-out property <bool> checked;

    height: 60px;
    border-radius: is_win11 ? 8px : 0px;
    background: is_dark ? #222222 : #f8f8f8;
    border-width: 1px;
    border-color: is_dark ? #333333 : #e6e6e6;

    TouchArea {
        clicked => { root.checked = !root.checked; }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 600;
                color: is_dark ? #ffffff : #1a1a1a;
            }

            Text {
                text: root.description;
                font-size: 11px;
                color: is_dark ? #999999 : #666666;
            }
        }

        HorizontalLayout {
            alignment: end;
            y: (parent.height - self.height) / 2;

            CheckBox {
                checked <=> root.checked;
            }
        }
    }
}

component DriveCard inherits Rectangle {
    in property <DriveItem> drive;
    in property <bool> is_selected: false;
    in property <bool> is_dark: false;
    in property <bool> is_win11: true;
    in property <string> fallback_label: "Unlabeled volume";
    in property <string> fallback_device: "Storage device";

    callback selected();
    callback double_clicked();
    callback quick_eject();

    height: 64px;
    border-radius: is_win11 ? 8px : 0px;
    
    // Background and border matching Windows 11 Fluent or Windows 10 Flat
    background: is_selected 
        ? (is_win11 
            ? (is_dark ? #005fb840 : #0067c018)
            : (is_dark ? #0078d738 : #0078d720))
        : (touch.has_hover 
            ? (is_dark ? #ffffff0d : #00000008)
            : (is_dark ? #272727 : #ffffff));

    border-width: 1px;
    border-color: is_selected
        ? (is_win11 
            ? (is_dark ? #4cc2ff80 : #0067c060)
            : (is_dark ? #0078d7 : #0078d7))
        : (is_dark ? #333333 : #e6e6e6);

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    // Left indicator bar (rounded pill on Win11, flat strip on Win10)
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: is_win11 ? 3px : 4px;
        height: is_selected ? (is_win11 ? 24px : parent.height) : 0px;
        border-radius: is_win11 ? 2px : 0px;
        background: is_win11 ? (is_dark ? #4cc2ff : #0067c0) : #0078d7;
        opacity: is_selected ? 1.0 : 0.0;
        animate height { duration: 120ms; easing: ease-out; }
        animate opacity { duration: 120ms; }
    }

    touch := TouchArea {
        clicked => { root.selected(); }
        double_clicked => { root.double_clicked(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        spacing: 12px;
        alignment: space-between;

        // Left section: Drive letter badge & information
        HorizontalLayout {
            spacing: 14px;
            alignment: start;

            // Drive letter badge
            Rectangle {
                width: 48px;
                height: 38px;
                border-radius: is_win11 ? 6px : 0px;
                background: is_dark ? #1e1e1e : #f0f0f0;
                border-width: 1px;
                border-color: is_dark ? #383838 : #dcdcdc;
                y: (parent.height - self.height) / 2;

                Text {
                    text: root.drive.mount_point;
                    font-size: 13px;
                    font-weight: 700;
                    color: is_dark ? #ffffff : #1a1a1a;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Label and hardware model details
            VerticalLayout {
                alignment: center;
                spacing: 3px;

                Text {
                    text: root.drive.label != "" ? root.drive.label : root.fallback_label;
                    font-size: 14px;
                    font-weight: 600;
                    font-italic: root.drive.label == "";
                    color: root.drive.label != "" 
                        ? (is_dark ? #ffffff : #1a1a1a)
                        : (is_dark ? #a0a0a0 : #707070);
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: (root.drive.vendor != "" || root.drive.product != "")
                            ? (root.drive.vendor + " " + root.drive.product)
                            : root.fallback_device;
                        font-size: 11px;
                        color: is_dark ? #9d9d9d : #6e6e6e;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: is_win11 ? 2px : 0px;
                        background: is_dark ? #555555 : #cccccc;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: root.drive.bus_type;
                        font-size: 11px;
                        font-weight: 600;
                        color: is_win11 ? (is_dark ? #4cc2ff : #005fb8) : #0078d7;
                    }
                }
            }
        }

        // Right section: Quick eject button on the row
        HorizontalLayout {
            alignment: end;
            y: (parent.height - self.height) / 2;
            height: 32px;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: is_win11 ? 5px : 0px;
                background: quick_touch.has_hover 
                    ? (is_dark ? #ffffff1a : #00000010) 
                    : transparent;

                quick_touch := TouchArea {
                    clicked => { root.quick_eject(); }
                }

                // Eject symbol icon (⏏)
                Text {
                    text: "⏏";
                    font-size: 14px;
                    color: quick_touch.has_hover
                        ? (is_dark ? #ffffff : #000000)
                        : (is_dark ? #888888 : #888888);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "USB Disk Remover";
    icon: @image-url("../icons/icon.png");
    min-width: 540px;
    min-height: 380px;
    preferred-width: 630px;
    preferred-height: 450px;

    in-out property <[DriveItem]> drives: [];
    in-out property <int> selected_index: -1;
    in-out property <bool> is_loading: false;
    in-out property <bool> is_ejecting: false;
    in-out property <string> status_text: "";
    in-out property <string> status_kind: "idle"; // "idle" | "ok" | "error"
    in-out property <string> app_version: "1.0.0";
    in-out property <bool> show_about: false;
    in-out property <bool> show_settings: false;

    // OS detection flag (Windows 11 vs Windows 10)
    in-out property <bool> is_win11: true;

    // Internationalization strings and selection
    in-out property <I18nStrings> t;
    in-out property <int> selected_language_index: 0;
    in-out property <[string]> available_languages: ["English", "Italiano", "Deutsch", "Français", "العربية", "Русский"];

    // Settings properties
    in-out property <bool> setting_start_with_windows: false;
    in-out property <bool> setting_start_minimized: false;
    in-out property <bool> setting_close_to_tray: true;

    callback refresh_drives();
    callback eject_selected();
    callback eject_drive(string);
    callback select_drive(int);
    callback toggle_about();
    callback toggle_settings();
    callback save_settings(bool, bool, bool);
    callback select_language(int);

    property <bool> is_dark: Palette.color-scheme == ColorScheme.dark;

    background: is_dark ? #202020 : #f3f3f3;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // ── Toolbar / Header ──────────────────────────────────────────────
        HorizontalLayout {
            height: 36px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                y: (parent.height - self.height) / 2;

                Image {
                    source: @image-url("../icons/32x32.png");
                    width: 24px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: "USB Disk Remover";
                    font-size: 16px;
                    font-weight: 700;
                    color: is_dark ? #ffffff : #1a1a1a;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 48px;
                    height: 18px;
                    border-radius: root.is_win11 ? 9px : 0px;
                    background: is_dark ? #2d2d2d : #e5e5e5;
                    y: (parent.height - self.height) / 2;

                    Text {
                        text: "v" + root.app_version;
                        font-size: 10px;
                        font-weight: 600;
                        color: is_dark ? #aaaaaa : #666666;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                y: (parent.height - self.height) / 2;

                Button {
                    text: root.t.settings_btn;
                    clicked => { root.toggle_settings(); }
                }

                Button {
                    text: root.t.about_btn;
                    clicked => { root.toggle_about(); }
                }

                Button {
                    text: root.is_loading ? root.t.scanning : root.t.refresh_btn;
                    enabled: !root.is_loading && !root.is_ejecting;
                    clicked => { root.refresh_drives(); }
                }
            }
        }

        // ── Drives Container ──────────────────────────────────────────────
        Rectangle {
            vertical-stretch: 1;
            border-radius: root.is_win11 ? 10px : 0px;
            background: is_dark ? #1c1c1c : #fbfbfb;
            border-width: 1px;
            border-color: is_dark ? #2e2e2e : #e6e6e6;
            clip: true;

            // Empty state
            if root.drives.length == 0 && !root.is_loading : VerticalLayout {
                alignment: center;
                spacing: 10px;

                Text {
                    text: "🔌";
                    font-size: 36px;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.t.no_drives_title;
                    font-size: 15px;
                    font-weight: 600;
                    color: is_dark ? #cccccc : #333333;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.t.no_drives_desc;
                    font-size: 12px;
                    color: is_dark ? #888888 : #777777;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    padding-top: 6px;
                    Button {
                        text: root.t.scan_for_drives;
                        clicked => { root.refresh_drives(); }
                    }
                }
            }

            // Loading state
            if root.is_loading && root.drives.length == 0 : VerticalLayout {
                alignment: center;
                spacing: 12px;

                Spinner {
                    indeterminate: true;
                    width: 32px;
                    height: 32px;
                }

                Text {
                    text: root.t.scanning;
                    font-size: 13px;
                    color: is_dark ? #999999 : #666666;
                    horizontal-alignment: center;
                }
            }

            // Drive list
            if root.drives.length > 0 : ScrollView {
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    alignment: start;

                    for drive[index] in root.drives : DriveCard {
                        drive: drive;
                        is_selected: root.selected_index == index;
                        is_dark: root.is_dark;
                        is_win11: root.is_win11;
                        fallback_label: root.t.unlabeled_volume;
                        fallback_device: root.t.storage_device;

                        selected => {
                            root.select_drive(index);
                        }
                        double_clicked => {
                            root.eject_drive(drive.mount_point);
                        }
                        quick_eject => {
                            root.eject_drive(drive.mount_point);
                        }
                    }
                }
            }
        }

        // ── Footer / Status Bar ───────────────────────────────────────────
        HorizontalLayout {
            height: 38px;
            alignment: space-between;

            // Status message
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                y: (parent.height - self.height) / 2;

                // Status dot indicator
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: root.is_win11 ? 4px : 0px;
                    y: (parent.height - self.height) / 2;
                    background: root.status_kind == "ok" 
                        ? (is_dark ? #54b054 : #107c41)
                        : (root.status_kind == "error"
                            ? (is_dark ? #ff99a4 : #d13438)
                            : (root.is_loading || root.is_ejecting
                                ? (is_dark ? #4cc2ff : #0067c0)
                                : (is_dark ? #666666 : #999999)));
                }

                Text {
                    text: root.status_text;
                    font-size: 12px;
                    color: root.status_kind == "ok"
                        ? (is_dark ? #54b054 : #107c41)
                        : (root.status_kind == "error"
                            ? (is_dark ? #ff99a4 : #d13438)
                            : (is_dark ? #9d9d9d : #666666));
                    vertical-alignment: center;
                }
            }

            // Action button
            HorizontalLayout {
                alignment: end;
                y: (parent.height - self.height) / 2;

                Button {
                    text: root.is_ejecting ? root.t.removing : root.t.safely_remove;
                    primary: true;
                    enabled: root.selected_index >= 0 && !root.is_ejecting && !root.is_loading;
                    clicked => { root.eject_selected(); }
                }
            }
        }
    }

    // ── Settings Modal Dialog ─────────────────────────────────────────────
    if root.show_settings : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000088;

        TouchArea {
            clicked => { root.toggle_settings(); }
        }

        Rectangle {
            width: 500px;
            height: 460px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: root.is_win11 ? 12px : 0px;
            background: is_dark ? #282828 : #ffffff;
            border-width: 1px;
            border-color: is_dark ? #3d3d3d : #e0e0e0;
            drop-shadow-blur: root.is_win11 ? 24px : 0px;
            drop-shadow-color: #00000044;

            TouchArea {}

            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                alignment: space-between;

                // Header
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.t.settings_title;
                        font-size: 18px;
                        font-weight: 700;
                        color: is_dark ? #ffffff : #111111;
                    }
                    Text {
                        text: root.t.settings_desc;
                        font-size: 12px;
                        color: is_dark ? #aaaaaa : #666666;
                    }
                }

                // Settings Cards
                VerticalLayout {
                    spacing: 8px;

                    // Language Selector
                    Rectangle {
                        height: 76px;
                        border-radius: root.is_win11 ? 8px : 0px;
                        background: is_dark ? #222222 : #f8f8f8;
                        border-width: 1px;
                        border-color: is_dark ? #333333 : #e6e6e6;

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;
                            alignment: space-between;

                            Text {
                                text: root.t.language_label;
                                font-size: 13px;
                                font-weight: 600;
                                color: is_dark ? #ffffff : #1a1a1a;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: space-between;

                                for lang[idx] in root.available_languages : Rectangle {
                                    border-radius: root.is_win11 ? 4px : 0px;
                                    background: root.selected_language_index == idx 
                                        ? (root.is_win11 
                                            ? (is_dark ? #4cc2ff : #0067c0)
                                            : #0078d7)
                                        : (lang_touch.has_hover 
                                            ? (is_dark ? #ffffff18 : #00000010)
                                            : (is_dark ? #2e2e2e : #ebebeb));
                                    border-width: 1px;
                                    border-color: root.selected_language_index == idx
                                        ? (root.is_win11 
                                            ? (is_dark ? #4cc2ff : #0067c0)
                                            : #0078d7)
                                        : (is_dark ? #3d3d3d : #d6d6d6);

                                    lang_touch := TouchArea {
                                        clicked => {
                                            root.selected_language_index = idx;
                                            root.select_language(idx);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        padding-top: 4px;
                                        padding-bottom: 4px;
                                        Text {
                                            text: lang;
                                            font-size: 11px;
                                            font-weight: root.selected_language_index == idx ? 700 : 500;
                                            color: root.selected_language_index == idx 
                                                ? (is_dark ? #000000 : #ffffff)
                                                : (is_dark ? #dddddd : #333333);
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    SettingCard {
                        is_dark: root.is_dark;
                        is_win11: root.is_win11;
                        title: root.t.autostart_title;
                        description: root.t.autostart_desc;
                        checked <=> root.setting_start_with_windows;
                    }

                    SettingCard {
                        is_dark: root.is_dark;
                        is_win11: root.is_win11;
                        title: root.t.start_minimized_title;
                        description: root.t.start_minimized_desc;
                        checked <=> root.setting_start_minimized;
                    }

                    SettingCard {
                        is_dark: root.is_dark;
                        is_win11: root.is_win11;
                        title: root.t.close_to_tray_title;
                        description: root.t.close_to_tray_desc;
                        checked <=> root.setting_close_to_tray;
                    }
                }

                // Buttons
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: root.t.save_btn;
                        primary: true;
                        clicked => {
                            root.save_settings(
                                root.setting_start_with_windows,
                                root.setting_start_minimized,
                                root.setting_close_to_tray
                            );
                            root.toggle_settings();
                        }
                    }

                    Button {
                        text: root.t.close_btn;
                        clicked => { root.toggle_settings(); }
                    }
                }
            }
        }
    }

    // ── About Modal Dialog ────────────────────────────────────────────────
    if root.show_about : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000088;

        about_touch := TouchArea {
            clicked => { root.toggle_about(); }
        }

        Rectangle {
            width: 420px;
            height: 300px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: root.is_win11 ? 12px : 0px;
            background: is_dark ? #282828 : #ffffff;
            border-width: 1px;
            border-color: is_dark ? #3d3d3d : #e0e0e0;
            drop-shadow-blur: root.is_win11 ? 24px : 0px;
            drop-shadow-color: #00000044;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 8px;
                    alignment: center;

                    Image {
                        source: @image-url("../icons/icon.png");
                        width: 48px;
                        height: 48px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "USB Disk Remover";
                        font-size: 18px;
                        font-weight: 700;
                        color: is_dark ? #ffffff : #111111;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Version " + root.app_version + " · 100% Rust & Slint";
                        font-size: 12px;
                        color: is_dark ? #aaaaaa : #666666;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: root.t.about_desc;
                        font-size: 11px;
                        color: is_dark ? #cccccc : #444444;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.t.about_ref;
                        font-size: 11px;
                        color: is_dark ? #888888 : #777777;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "MIT License";
                        font-size: 10px;
                        color: is_dark ? #666666 : #999999;
                        horizontal-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    Button {
                        text: root.t.close_btn;
                        clicked => { root.toggle_about(); }
                    }
                }
            }
        }
    }
}
